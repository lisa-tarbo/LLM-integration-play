{
  "model": "claude-sonnet-5",
  "modelSettings": {
    "claude-sonnet-5": { "effortLevel": "high" }
  },
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git ls-tree *)",
      "Bash(jupyter nbconvert *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Skill(create-pr)",
      "Skill(create-pr:*)",
      "Bash(gh --version)"
    ],
    "deny": [
      "mcp__*",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",
      "Bash(git push --force*)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["/tmp/*"],
      "allowRead": ["~/.config/git/ignore"],
      "denyRead":["~/.aws/*", "~/.ssh/*", "~/.config/uv/*", "~/.config/azure/*", "~/.config/go/*", "~/.config/gh/*", "~/.config/git/*"],
      "denyWrite": ["~/.aws/*", "~/.ssh/*", "~/.config/uv/*", "~/.config/azure/*", "~/.config/go/*", "~/.config/gh/*", "~/.config/git/*","/etc", "/usr/local/bin"]

    },
    "network": {
      "allowedDomains": ["docs.openchatstudio.com/*"]
    },
    "excludedCommands": ["docker *"]
  },
  "disableBundledSkills": true,
  "disableSkillShellExecution": true,
  "cleanupPeriodDays": 20
}
