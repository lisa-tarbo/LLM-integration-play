{
  "model": "claude-sonnet-5",
  "modelSettings": {
    "claude-sonnet-5": { "effortLevel": "high" }
  },
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git ls-tree *)",
      "Bash(jupyter nbconvert *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Skill(create-pr)",
      "Skill(create-pr:*)",
      "Bash(gh --version)"
    ],
    "deny": [
      "mcp__*",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",
      "Bash(git push --force*)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env*)",
      "Bash(cat *.env)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(grep * .env*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false
  },
  "cleanupPeriodDays": 20
}
